import("//drivers/external_device_manager/extdevmgr.gni")

ohos_static_library("recovery_mode_checker") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  sources = [
    "recovery_mode_checker.cpp",
  ]
  include_dirs = [
    "${ext_mgr_path}/services/native/driver_extension_manager/include",
    "${ext_mgr_path}/utils/include",
  ]
  configs = [ "${utils_path}:utils_config" ]
  external_deps = [
    "hilog:libhilog",
    "init:libbegetutil",
  ]
  subsystem_name = "hdf"
  part_name = "external_device_manager"
}

# Test-only variant: provides the UT/fuzz injection hooks without exposing them
# in the production library. Test targets must define RECOVERY_MODE_TEST_HOOKS.
ohos_static_library("recovery_mode_checker_test_hooks") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  sources = [
    "recovery_mode_checker.cpp",
  ]
  include_dirs = [
    "${ext_mgr_path}/services/native/driver_extension_manager/include",
    "${ext_mgr_path}/utils/include",
  ]
  configs = [ "${utils_path}:utils_config" ]
  defines = [ "RECOVERY_MODE_TEST_HOOKS" ]
  external_deps = [
    "hilog:libhilog",
    "init:libbegetutil",
  ]
  subsystem_name = "hdf"
  part_name = "external_device_manager"
}
