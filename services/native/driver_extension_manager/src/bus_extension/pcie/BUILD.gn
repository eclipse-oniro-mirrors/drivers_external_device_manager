import("../../../../../../extdevmgr.gni")

config("pcie_driver_public_config") {
  include_dirs = [
    "${ext_mgr_path}/services/native/driver_extension_manager/include",
  ]
}

if (external_device_manager_enable_pcie) {
  ohos_static_library("pcie_driver_manager") {
    branch_protector_ret = "pac_ret"
    sanitize = {
      cfi = true
      cfi_cross_dso = true
      debug = false
    }
    sources = [
      "common/pcie_wildcard_match.cpp",
      "manager/pcie_driver_manager.cpp",
      "metadata/pcie_driver_metadata_parser.cpp",
      "modprobe/pcie_driver_module_index.cpp",
      "policy/pcie_driver_match_policy.cpp",
      "system/security_query.cpp",
    ]

    public_configs = [ ":pcie_driver_public_config" ]
    configs = [ "${utils_path}:utils_config" ]
    external_deps = [
      "drivers_interface_pcie:pcie_interface_idl_headers",
      "c_utils:utils",
      "hdf_core:libhdf_utils",
      "hilog:libhilog",
      "init:libbegetutil",
    ]
    subsystem_name = "hdf"
    part_name = "external_device_manager"
  }
} else {
  group("pcie_driver_manager") {}
}
