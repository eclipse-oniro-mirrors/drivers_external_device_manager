import("//build/ohos.gni")
import("//build/test.gni")
ext_mgr_path = "//drivers/external_device_manager"
utils_path = "//drivers/external_device_manager/utils"

module_output_path = "external_device_manager/extension_device_manager"

ohos_benchmarktest("hdf_etx_device_mgr_benchmark_test") {
  module_out_path = module_output_path

  include_dirs = [
    "${ext_mgr_path}/services/native/driver_extension_manager/include/device_manager",
    "${ext_mgr_path}/services/native/driver_extension_manager/include/drivers_pkg_manager",
    "${ext_mgr_path}/services/native/driver_extension_manager/include/drivers_hisysevent",
    "${ext_mgr_path}/services/native/driver_extension_manager/include/bus_extension/core",
    "${ext_mgr_path}/services/native/driver_extension_manager/include",
    "${ext_mgr_path}/interfaces/innerkits/",
    "${ext_mgr_path}/utils/include/",
  ]

  sources = [
    "${ext_mgr_path}/services/native/driver_extension_manager/src/driver_ext_mgr_type.cpp",
    "ext_dev_mgr/etx_device_mgr_benchmark_test.cpp"
  ]

  deps = [
    "${ext_mgr_path}/interfaces/innerkits:driver_ext_mgr_client",
    "${ext_mgr_path}/interfaces/innerkits:external_device_manager_stub",
    "${ext_mgr_path}/services/native/driver_extension_manager/src/device_manager:driver_extension_device_manager_test",
    "${ext_mgr_path}/services/native/driver_extension_manager/src/drivers_pkg_manager:drivers_pkg_manager_test",
  ]

  external_deps = [
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "bundle_framework:appexecfwk_core",
    "bundle_framework:libappexecfwk_common",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
  ]

  external_deps += [
    "benchmark:benchmark",
    "googletest:gtest_main",
  ]

  configs = [ "${utils_path}:utils_config" ]

  subsystem_name = "hdf"
  part_name = "external_device_manager"
}

ohos_benchmarktest("hdf_ext_permission_manager_benchmark_test") {
  module_out_path = module_output_path

  include_dirs = [
    "${ext_mgr_path}/services/native/driver_extension_manager/include",
    "${ext_mgr_path}/services/native/driver_extension_manager/include/device_manager",
    "${ext_mgr_path}/interfaces/innerkits/",
    "${ext_mgr_path}/utils/include/",
  ]

  sources = [ "ext_dev_mgr/ext_permission_manager_benchmark_test.cpp" ]

  deps = [
    "${ext_mgr_path}/interfaces/innerkits:external_device_manager_stub",
    "${ext_mgr_path}/services/native/driver_extension_manager/src/device_manager:driver_extension_device_manager_test",
    "${ext_mgr_path}/services/native/driver_extension_manager/src/drivers_hisysevent:report_sys_event",
    "${ext_mgr_path}/services/native/driver_extension_manager/src/drivers_pkg_manager:drivers_pkg_manager_test",
  ]

  external_deps = [
    "access_token:libtokenid_sdk",
    "access_token:libaccesstoken_sdk",
    "access_token:libnativetoken",
    "access_token:libtoken_setproc",
    "bundle_framework:appexecfwk_core",
    "bundle_framework:libappexecfwk_common",
    "cJSON:cjson",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
  ]

  external_deps += [
    "benchmark:benchmark",
    "googletest:gtest_main",
  ]

  configs = [ "${utils_path}:utils_config" ]

  subsystem_name = "hdf"
  part_name = "external_device_manager"
}

ohos_benchmarktest("hdf_event_config_benchmark_test") {
  module_out_path = module_output_path

  include_dirs = [
    "${ext_mgr_path}/services/native/driver_extension_manager/include",
    "${ext_mgr_path}/interfaces/innerkits/",
    "${ext_mgr_path}/utils/include/",
  ]

  sources = [
    "${ext_mgr_path}/services/native/driver_extension_manager/src/event_config.cpp",
    "ext_dev_mgr/event_config_benchmark_test.cpp",
  ]

  external_deps = [
    "cJSON:cjson",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
  ]

  external_deps += [
    "benchmark:benchmark",
    "googletest:gtest_main",
  ]

  configs = [ "${utils_path}:utils_config" ]

  defines = [ "private = public" ]

  subsystem_name = "hdf"
  part_name = "external_device_manager"
}

group("hdf_etx_device_mgr_benchmark") {
  testonly = true
  deps = [
    ":hdf_etx_device_mgr_benchmark_test",
    ":hdf_ext_permission_manager_benchmark_test",
    ":hdf_event_config_benchmark_test",
  ]
}
