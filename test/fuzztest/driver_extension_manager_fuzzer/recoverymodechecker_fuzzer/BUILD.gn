import("//build/config/features.gni")
import("//build/ohos.gni")
import("//build/test.gni")
import("//drivers/external_device_manager/extdevmgr.gni")

ohos_fuzztest("RecoveryModeCheckerFuzzTest") {
  module_out_path = "external_device_manager/external_device_manager"

  fuzz_config_file = "${ext_mgr_path}/test/fuzztest/driver_extension_manager_fuzzer/recoverymodechecker_fuzzer"

  include_dirs = [
    "${ext_mgr_path}/services/native/driver_extension_manager/include/",
    "${ext_mgr_path}/utils/include/",
  ]

  sources = [ "recoverymodechecker_fuzzer.cpp" ]

  deps = [ "${ext_mgr_path}/services/native/driver_extension_manager/src/utils:recovery_mode_checker_test_hooks" ]

  configs = [ "${utils_path}:utils_config" ]
  defines = [ "RECOVERY_MODE_TEST_HOOKS" ]

  external_deps = [
    "hilog:libhilog",
    "init:libbegetutil",
  ]
  subsystem_name = "hdf"
  part_name = "external_device_manager"
}
