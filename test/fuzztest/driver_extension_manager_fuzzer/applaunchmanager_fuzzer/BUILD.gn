import("//build/config/features.gni")
import("//build/ohos.gni")
import("//build/test.gni")
import("//drivers/external_device_manager/extdevmgr.gni")
module_output_path = "external_device_manager/external_device_manager"

ohos_fuzztest("AppLaunchManagerFuzzTest") {
  module_out_path = module_output_path
  fuzz_config_file = "${ext_mgr_path}/test/fuzztest/driver_extension_manager_fuzzer/applaunchmanager_fuzzer"

  sources = [ "applaunchmanager_fuzzer.cpp" ]

  include_dirs = [
    "${ext_mgr_path}/services/native/driver_extension_manager/include",
    "${ext_mgr_path}/services/native/driver_extension_manager/include/app_launch_manager",
    "${ext_mgr_path}/services/native/driver_extension_manager/include/device_notification",
  ]

  deps = [
    "${ext_mgr_path}/services/native/driver_extension_manager/src/app_launch_manager:app_launch_manager",
    "${ext_mgr_path}/services/native/driver_extension_manager/src/bus_extension/core:driver_extension_bus_core",
    "${ext_mgr_path}/services/native/driver_extension_manager/src/drivers_pkg_manager:drivers_pkg_manager",
  ]

  external_deps = [
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
  ]

  defines = []
  configs = [ "${utils_path}:utils_config" ]
}
